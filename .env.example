# RaktSetu environment
# Copy to .env and adjust. NEVER commit real secrets.

# 32+ char random string. Required in production. Generate: openssl rand -base64 32
APP_SECRET=dev-insecure-secret-change-me-0123456789abcdef

# PostgreSQL (primary target, docker-compose): postgresql://raktsetu:raktsetu@localhost:5432/raktsetu
# SQLite dev fallback: file:./dev.db
DATABASE_URL=file:./dev.db

# Demo mode enables simulator + mock adapters + relaxed thresholds. NEVER true in production.
DEMO_MODE=false

# Privacy thresholds
PRIVACY_MIN_COHORT=5
PRIVACY_MIN_AGGREGATE=10

# Sessions / security
SESSION_TTL_DAYS=30
REPLAY_WINDOW_SECONDS=300

# Canonical public origin of this deployment (used for metadata/OG + links).
# REQUIRED in production — the app refuses to boot with localhost or a missing value.
# NEXT_PUBLIC_APP_URL=https://raktsetu.example.org

# TOTP MFA for ORG_ADMIN / PLATFORM_ADMIN logins. Defaults to ON in production,
# OFF in development. Set false only on pure-demo deployments.
# REQUIRE_ADMIN_MFA=true

# Email delivery for the outbox queue.
# console  -> structured log, no external service (dev/self-host default)
# resend   -> requires RESEND_API_KEY + EMAIL_FROM
EMAIL_PROVIDER=console
# RESEND_API_KEY=re_xxxxxxxxxxxx
# EMAIL_FROM=RaktSetu <notifications@yourdomain.example>

# Shared secret for cron endpoints (Authorization: Bearer). Required in production.
# CRON_SECRET=generate-a-long-random-string
