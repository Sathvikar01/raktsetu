# RaktSetu environment
# Copy to .env and adjust. NEVER commit real secrets.

# 32+ char random string. Required in production. Generate: openssl rand -base64 32
APP_SECRET=dev-insecure-secret-change-me-0123456789abcdef

# PostgreSQL (primary target, docker-compose): postgresql://raktsetu:raktsetu@localhost:5432/raktsetu
# SQLite dev fallback: file:./dev.db
DATABASE_URL=file:./dev.db

# Demo mode enables simulator + mock adapters + relaxed thresholds. NEVER true in production.
DEMO_MODE=false

# Privacy thresholds
PRIVACY_MIN_COHORT=5
PRIVACY_MIN_AGGREGATE=10

# Sessions / security
SESSION_TTL_DAYS=30
REPLAY_WINDOW_SECONDS=300
