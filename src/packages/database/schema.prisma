// RaktSetu — database schema
// Portable across PostgreSQL (primary, docker-compose) and SQLite (zero-dep dev/test fallback).
// Consequences of portability: enums are Strings validated by zod in packages/schemas,
// and JSON payloads are stored as serialized String fields (payloadJson) — see lib/json.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  displayName  String
  role         String   @default("DONOR") // DONOR | ORG_STAFF | ORG_ADMIN | PLATFORM_ADMIN
  status       String   @default("ACTIVE") // ACTIVE | DISABLED
  mfaEnabled   Boolean  @default(false)
  // TOTP (RFC 6238) MFA for privileged roles. Secret is base32; stored
  // unhashed because it must be reusable for verification (like password
  // hashes, never rendered in exports/logs).
  mfaSecret      String?
  mfaEnrolledAt  DateTime?
  mfaLastCounter Int       @default(0)
  emailVerifiedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  donorProfile          DonorProfile?
  sessions              Session[]
  orgMemberships        OrganizationUser[]
  notifications         Notification[]
  notificationPreference NotificationPreference?
  passwordResetTokens   PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
}

// Single-use, hashed email verification tokens (24h expiry).
model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model DonorProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bloodGroup      String?
  birthYear       Int?
  phone           String? // optional, minimized; only for notification delivery if opted in
  preferredLocale String   @default("en")
  createdAt       DateTime @default(now())
  // ---------------------------------------------------------------------------
  // Emergency donor-network fields. Phone is stored BOTH encrypted (AES-256-GCM,
  // delivery only) and hashed (HMAC, lookup/throttle) — it is never rendered in
  // any donor-facing surface. Coordinates are quantized to ~1km at write time.
  // ---------------------------------------------------------------------------
  phoneHash       String? // HMAC-SHA256 of normalized E.164 — dedupe/lookup, irreversible
  phoneEncrypted  String? // AES-256-GCM(APP_SECRET) — decrypted only for dispatch
  phoneVerifiedAt DateTime?
  latitude        Float? // quantized (~1km grid); approximate by construction
  longitude       Float?
  locationLabel   String? // user-chosen coarse label e.g. "Kothrud, Pune"
  available       Boolean  @default(true) // master availability switch (pause = false)
  pausedAt        DateTime?
  notifyRadiusKm  Int      @default(15) // how far the donor is willing to be notified
  lastDonationAt  DateTime? // self-reported until a LINKED donation supersedes it
  onboardedAt     DateTime?

  donations        Donation[]
  emergencyMatches EmergencyMatch[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  ipHash    String?
  userAgent String?
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Organizations (blood banks / hospitals) & staff membership
// ---------------------------------------------------------------------------

model Organization {
  id          String   @id @default(uuid())
  name        String
  kind        String // BLOOD_BANK | HOSPITAL | BLOOD_BANK_AND_HOSPITAL
  status      String   @default("PENDING_APPROVAL") // PENDING_APPROVAL | ACTIVE | SUSPENDED
  regionLabel String? // coarse public-safe label e.g. "Pune, Maharashtra"
  // Public facility coordinates — blood banks are public places, so a coarse
  // (2-decimal, ~1km) geolocation is safe to publish and powers nearby search.
  latitude    Float?
  longitude   Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  facilities      Facility[]
  members         OrganizationUser[]
  donations       Donation[]
  lifecycleEvents LifecycleEvent[]
  integrations    Integration[]
  recipientRefs   RecipientContext[]
  requestsMade    BloodRequest[]     @relation("requestsMade")
  requestsReceived BloodRequest[]    @relation("requestsReceived")
  invites         OrgInvite[]
  camps           Camp[]
  emergencyMatches EmergencyMatch[]
}

model Facility {
  id             String  @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  code           String
  city           String?
  state          String?
  kind           String // COLLECTION_CENTRE | PROCESSING_LAB | HOSPITAL | STORE
  externalCode   String?

  @@unique([organizationId, code])
}

model OrganizationUser {
  id        String   @id @default(uuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String // ORG_ADMIN | STAFF
  status    String   @default("ACTIVE") // ACTIVE | DISABLED
  createdAt DateTime @default(now())

  @@unique([orgId, userId])
}

// Inbound partner onboarding requests (public form) — reviewed by platform admins.
model PartnerRequest {
  id          String   @id @default(uuid())
  orgName     String
  orgKind     String // BLOOD_BANK | HOSPITAL | NGO
  contactName String
  workEmail   String
  city        String?
  state       String?
  message     String?
  status      String   @default("PENDING") // PENDING | REVIEWED | APPROVED | REJECTED
  ipHash      String?
  createdAt   DateTime @default(now())

  @@index([status, createdAt])
}

// One-time organization-admin invite issued when a partner request is approved.
// Token is stored hashed (like password/email reset tokens); the plaintext is
// only ever in the invite email.
model OrgInvite {
  id          String    @id @default(uuid())
  email       String
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role        String    @default("ORG_ADMIN") // ORG_ADMIN | ORG_STAFF
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  invitedById String?
  createdAt   DateTime  @default(now())

  @@index([email])
}

// ---------------------------------------------------------------------------
// Donations, identifiers, components, lineage
// ---------------------------------------------------------------------------

model Donation {
  id               String   @id @default(uuid())
  donorProfileId   String?
  donorProfile     DonorProfile? @relation(fields: [donorProfileId], references: [id])
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  facilityId       String?
  externalDonationId String // blood bank's own donation/unit id
  din              String? // ISBT 128 Donation Identification Number when present
  bloodGroup       String? // ABO/Rh of the unit as recorded by the blood bank (BLOOD_GROUPS)
  donatedAt        DateTime
  linkStatus       String   @default("UNLINKED") // UNLINKED | LINKED | REVOKED
  linkCode         String   @unique @default(cuid())
  recordedVia      String? // integrationId or "MANUAL" or "SEED"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  components         BloodComponent[]
  events             LifecycleEvent[]

  @@unique([organizationId, externalDonationId])
}

model ExternalIdentifier {
  id             String @id @default(uuid())
  entityType     String // DONATION | COMPONENT
  entityId       String // polymorphic id (no FK) — resolved via entityType
  scheme         String // ISBT128_DIN | FACILITY_BARCODE | ERAKTKOSH_ID | HOSPITAL_LOCAL
  value          String
  organizationId String

  @@unique([scheme, value])
}

model BloodComponent {
  id                 String   @id @default(uuid())
  donationId         String
  donation           Donation @relation(fields: [donationId], references: [id])
  componentType      String // RBC | PLASMA | PLATELET | WHOLE_BLOOD | OTHER
  externalComponentId String?
  // Denormalized inventory facts (events remain the source of truth):
  bloodGroup         String?  // copied from the donation at creation
  expiresAt          DateTime? // computed from shelf life at creation (domain/shelf-life)
  locationFacilityId String?  // derived cache: facility of the last verified event
  preparedAt         DateTime?
  currentDerivedState String  @default("PREPARING") // derived cache; events are truth
  derivedAt          DateTime?
  createdAt          DateTime @default(now())

  events            LifecycleEvent[]
  lineageParents    ComponentLineage[] @relation("child")
  lineageChildren   ComponentLineage[] @relation("parent")
  recipientContexts RecipientContext[]
  requestFulfillments RequestFulfillment[]

  @@unique([donationId, componentType])
  @@index([currentDerivedState, expiresAt])
}

// ---------------------------------------------------------------------------
// Hospital -> blood bank unit requests (activates COMPONENT_RESERVED)
// ---------------------------------------------------------------------------

model BloodRequest {
  id              String   @id @default(uuid())
  requestNumber   String   @unique @default(cuid())
  requestingOrgId String
  requestingOrg   Organization @relation("requestsMade", fields: [requestingOrgId], references: [id])
  targetOrgId     String
  targetOrg       Organization @relation("requestsReceived", fields: [targetOrgId], references: [id])
  componentType   String // RBC | PLASMA | PLATELET | WHOLE_BLOOD | OTHER
  bloodGroup      String // ABO/Rh (BLOOD_GROUPS)
  unitsRequested  Int
  urgency         String   @default("ROUTINE") // ROUTINE | URGENT | EMERGENCY
  note            String? // free-text clinical context is discouraged — keep coarse
  status          String   @default("PENDING") // PENDING | FULFILLED | DECLINED | CANCELLED
  declineReason   String?
  requestedById   String? // User.id of the hospital staff member who raised it
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  fulfillments RequestFulfillment[]

  @@index([targetOrgId, status, createdAt])
  @@index([requestingOrgId, status, createdAt])
}

model RequestFulfillment {
  id             String @id @default(uuid())
  requestId      String
  request        BloodRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  componentId    String
  component      BloodComponent @relation(fields: [componentId], references: [id])
  createdByOrgId String // the blood bank that reserved the unit
  createdAt      DateTime @default(now())

  @@unique([requestId, componentId])
}

model ComponentLineage {
  id               String  @id @default(uuid())
  parentComponentId String?
  parent           BloodComponent? @relation("parent", fields: [parentComponentId], references: [id])
  childComponentId String?
  child            BloodComponent? @relation("child", fields: [childComponentId], references: [id])
  relationType     String // DERIVED_FROM | POOLED_INTO | SPLIT_FROM
  note             String?
  createdAt        DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Immutable lifecycle event log
// ---------------------------------------------------------------------------

model LifecycleEvent {
  id                   String    @id @default(uuid())
  donationId           String?
  donation             Donation? @relation(fields: [donationId], references: [id])
  componentId          String?
  component            BloodComponent? @relation(fields: [componentId], references: [id])
  eventType            String
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id])
  facilityId           String?
  occurredAt           DateTime
  receivedAt           DateTime  @default(now())
  sourceSystem         String
  sourceEventId        String
  verificationStatus   String    @default("VERIFIED") // VERIFIED | PENDING | REJECTED
  payloadJson          String? // sanitized metadata allowed for this event type
  previousEventId      String?
  correctionForEventId String?
  supersededByCorrection Boolean @default(false)
  integrationId        String?
  ingestedByUserId     String? // staff manual entry / simulator attribution
  createdAt            DateTime  @default(now())

  disclosureDecisions DisclosureDecision[]
  recipientContexts   RecipientContext[]

  @@unique([sourceSystem, sourceEventId])
  @@index([componentId, occurredAt])
  @@index([donationId, occurredAt])
}

// ---------------------------------------------------------------------------
// Recipient privacy model — opaque by construction
// ---------------------------------------------------------------------------

model RecipientContext {
  id                String   @id @default(uuid())
  recipientRef      String   @unique // random opaque identifier generated by hospital side
  componentId       String
  component         BloodComponent @relation(fields: [componentId], references: [id])
  eventId           String?
  event             LifecycleEvent? @relation(fields: [eventId], references: [id])
  facilityOrgId     String
  organization      Organization @relation(fields: [facilityOrgId], references: [id])
  ageBand           String? // <18 | 18-40 | 40-60 | 60+ — coarse only
  treatmentCategory String? // whitelisted broad category code
  createdAt         DateTime @default(now())
}

model DisclosureConsent {
  id            String   @id @default(uuid())
  recipientRef  String
  level         String // NONE | BROAD_PURPOSE | LIMITED_ANON
  category      String? // required when level != NONE
  policyVersion String   @default("1.0")
  verifiedByOrgId String
  verifiedAt    DateTime @default(now())
  expiresAt     DateTime?
  revokedAt     DateTime?
  createdAt     DateTime @default(now())
}

model DisclosureDecision {
  id               String   @id @default(uuid())
  eventId          String
  event            LifecycleEvent @relation(fields: [eventId], references: [id])
  requestedLevel   String
  grantedLevel     String // NONE | BROAD_PURPOSE | LIMITED_ANON
  messageKey       String // i18n template key rendered to donor
  paramsJson       String? // sanitized template params only
  degradedReason   String? // e.g. COHORT_TOO_SMALL, CATEGORY_UNKNOWN, CONSENT_EXPIRED
  provenanceJson   String // chain: decision -> event -> org -> source ids
  cohortSize       Int?
  createdAt        DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Notifications & preferences
// ---------------------------------------------------------------------------

model Notification {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  typeKey     String // e.g. notify.component.prepared
  titleParamsJson String?
  bodyParamsJson  String?
  genericTitle Boolean  @default(true) // lock-screen-safe generic title flag
  privacySafeBody Boolean @default(true)
  readAt      DateTime?
  channels    String    @default("IN_APP") // comma list actually dispatched
  relatedDonationId String?
  relatedComponentId String?
  createdAt   DateTime  @default(now())
}

model OutboxEmail {
  id        String   @id @default(uuid())
  toEmail   String
  subject   String
  bodyText  String
  status    String   @default("QUEUED") // QUEUED | SENT(dev=logged) | FAILED
  sentAt    DateTime?
  createdAt DateTime @default(now())
}

model NotificationPreference {
  id                      String @id @default(uuid())
  userId                  String @unique
  user                    User   @relation(fields: [userId], references: [id])
  inApp                   Boolean @default(true)
  email                   Boolean @default(true)
  sms                     Boolean @default(false) // future channel adapters
  whatsapp                Boolean @default(false)
  push                    Boolean @default(false)
  descriptiveContent      Boolean @default(false) // opt-in to more descriptive bodies
  donationReminders       Boolean @default(false) // opt-in one-shot "likely eligible again" reminder per donation
  locale                  String  @default("en")
}

// Consent records are versioned and append-oriented (revocation sets revokedAt).
model ConsentRecord {
  id            String    @id @default(uuid())
  subjectType   String // DONOR_PLATFORM | RECIPIENT_CONTEXT
  subjectRef    String // userId or recipientRef
  purposeKey    String // notifications.email, notifications.descriptive, data.export ...
  granted       Boolean
  policyVersion String    @default("1.0")
  textDigest    String? // sha256 of exact consent text shown
  grantedAt     DateTime  @default(now())
  revokedAt     DateTime?
}

// ---------------------------------------------------------------------------
// Integrations
// ---------------------------------------------------------------------------

model Integration {
  id          String   @id @default(uuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id])
  name        String
  adapterType String // MOCK_BLOOD_BANK | MOCK_HOSPITAL | WEBHOOK | CSV_IMPORT | FHIR | ERAKTKOSH
  status      String   @default("ACTIVE") // ACTIVE | DISABLED
  description String?
  createdAt   DateTime @default(now())

  credentials IntegrationCredential[]
  events      IntegrationEvent[]
}

model IntegrationCredential {
  id            String    @id @default(uuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id])
  keyId         String    @unique // public id, sent as X-RaktSetu-Key
  secretEncrypted String // AES-256-GCM(APP_SECRET); server-side HMAC verification needs raw secret
  scopes        String    @default("events:write") // space-separated
  status        String    @default("ACTIVE") // ACTIVE | REVOKED
  lastUsedAt    DateTime?
  rotatedAt     DateTime?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
}

model IntegrationEvent {
  id              String   @id @default(uuid())
  integrationId   String
  integration     Integration @relation(fields: [integrationId], references: [id])
  direction       String   @default("INBOUND")
  bodySha256      String
  disposition     String // ACCEPTED | DUPLICATE | INVALID | UNAUTHORIZED | ERROR
  errorDetail     String?
  lifecycleEventId String?
  receivedAt      DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Audit log — append-only
// ---------------------------------------------------------------------------

model AuditLog {
  id           String   @id @default(uuid())
  actorType    String // USER | INTEGRATION | SYSTEM
  actorId      String?
  action       String // e.g. event.ingested, donation.linked, consent.recorded
  resourceType String
  resourceId   String?
  orgId        String?
  ipHash       String?
  metadataJson String? // sanitized only — no PII/PHI beyond ids
  createdAt    DateTime @default(now())

  @@index([resourceType, resourceId])
  @@index([orgId, createdAt])
}


// ---------------------------------------------------------------------------
// Public emergency blood discovery — request lifecycle, bank/donor matches
// Lifecycle: PENDING -> SEARCHING_BANKS -> SEARCHING_DONORS -> DONOR_FOUND ->
// FULFILLED, with EXPIRED / CANCELLED exits. Donor matches are privacy-first:
// requester-facing surfaces expose blood group + approximate distance only
// until the donor accepts.
// ---------------------------------------------------------------------------

model EmergencyRequest {
  id              String   @id @default(uuid())
  requestNumber   String   @unique @default(cuid())
  publicToken     String   @unique // random; authorizes public status polling without login
  componentType   String // RBC | PLASMA | PLATELET | WHOLE_BLOOD | OTHER
  bloodGroup      String // recipient ABO/Rh (BLOOD_GROUPS)
  unitsRequested  Int
  urgency         String // ROUTINE | URGENT | EMERGENCY
  status          String   @default("PENDING") // PENDING | SEARCHING_BANKS | SEARCHING_DONORS | DONOR_FOUND | FULFILLED | EXPIRED | CANCELLED
  hospitalName    String
  city            String
  latitude        Float?
  longitude       Float?
  contactName     String
  contactPhoneHash     String // HMAC of normalized E.164 — dedupe/lookup
  contactPhoneEncrypted String // AES-256-GCM(APP_SECRET) — decrypted only to call the requester back
  phoneVerifiedAt DateTime? // set when OTP verification consumed at creation
  requesterUserId String? // optional logged-in account for in-app updates
  radiusKm        Int? // current donor-search radius (progressive expansion)
  radiusRound     Int      @default(0) // index into the urgency's radius ladder
  lastDonorScanAt DateTime? // anchors the per-round dwell before widening again
  moderationStatus String  @default("CLEAR") // CLEAR | FLAGGED | BLOCKED
  flagReason      String?
  expiresAt       DateTime
  fulfilledAt     DateTime?
  fulfilledSource String? // BANK_INVENTORY | DONOR_ACCEPTED | REQUESTER_CONFIRMED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  events  EmergencyRequestEvent[]
  matches EmergencyMatch[]

  @@index([status, expiresAt])
  @@index([contactPhoneHash, createdAt])
}

// Append-only stage timeline powering the real-time status view.
model EmergencyRequestEvent {
  id         String           @id @default(uuid())
  requestId  String
  request    EmergencyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  stage      String // mirrors status keys + SEARCH_HINTS stages
  detailJson String? // sanitized, non-identifying detail only
  createdAt  DateTime         @default(now())

  @@index([requestId, createdAt])
}

model EmergencyMatch {
  id             String   @id @default(uuid())
  requestId      String
  request        EmergencyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  kind           String // BANK | DONOR
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  donorProfileId String?
  donorProfile   DonorProfile?  @relation(fields: [donorProfileId], references: [id])
  bloodGroup     String // donor's group (banks: group of the units found)
  unitsAvailable Int? // BANK matches only
  distanceKm     Float?
  radiusKm       Int? // radius at which this match was created
  status         String   @default("NOTIFIED") // BANK: LISTED ; DONOR: NOTIFIED | ACCEPTED | DECLINED | EXPIRED
  notifiedAt     DateTime?
  respondedAt    DateTime?
  acceptedAt     DateTime?
  createdAt      DateTime @default(now())

  @@unique([requestId, organizationId])
  @@unique([requestId, donorProfileId])
  @@index([donorProfileId, status])
  @@index([organizationId, createdAt])
}

// ---------------------------------------------------------------------------
// Mobile OTP verification (donor onboarding + emergency requests)
// Codes are stored hashed; verification issues a one-time verification token
// consumed by the downstream mutation. Throttling lives in RateLimitBucket.
// ---------------------------------------------------------------------------

model OtpChallenge {
  id             String    @id @default(uuid())
  purpose        String // DONOR_PHONE | EMERGENCY_REQUEST
  phoneHash      String // HMAC of normalized E.164
  codeHash       String // SHA-256 over APP_SECRET-peppered code
  attempts       Int       @default(0)
  expiresAt      DateTime
  consumedAt     DateTime?
  verifiedTokenHash String? // issued when a code verifies; one-time use
  verifiedTokenExpiresAt DateTime?
  verifiedTokenUsedAt    DateTime?
  ipHash         String?
  createdAt      DateTime  @default(now())

  @@index([phoneHash, purpose, createdAt])
}

// ---------------------------------------------------------------------------
// Blood donation camps — discovery (public) + verification (platform admins)
// ---------------------------------------------------------------------------

model Camp {
  id             String   @id @default(uuid())
  orgId          String // verified organizer (ACTIVE organization)
  org            Organization @relation(fields: [orgId], references: [id])
  name           String
  description    String?
  venue          String
  city           String
  state          String?
  latitude       Float?
  longitude      Float?
  startsAt       DateTime
  endsAt         DateTime
  status         String   @default("PENDING_APPROVAL") // PENDING_APPROVAL | APPROVED | REJECTED | CANCELLED | COMPLETED
  createdById    String
  approvedById   String?
  approvedAt     DateTime?
  rejectedReason String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  registrations CampRegistration[]

  @@index([status, startsAt])
  @@index([orgId, startsAt])
}

model CampRegistration {
  id               String @id @default(uuid())
  campId           String
  camp             Camp   @relation(fields: [campId], references: [id], onDelete: Cascade)
  userId           String? // logged-in donor registration (unique per camp)
  name             String
  contactPhoneHash String?
  headcount        Int    @default(1)
  createdAt        DateTime @default(now())

  @@unique([campId, userId])
  @@index([campId, createdAt])
}

// ---------------------------------------------------------------------------
// Persistent rate limiting (multi-instance safe)
// ---------------------------------------------------------------------------

model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
  updatedAt   DateTime @updatedAt
}